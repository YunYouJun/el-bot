# Experimental: run the bridge on the same cloud computer as the Grok routine.
# Fill credentials through a secure input flow, never through ordinary chat.
WECOM_BOT_TYPE=smart
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret
WECOM_GROK_CONFIG=./binding.json
GROK_BOT_WEBHOOK_URL=https://example.invalid/official-routine-webhook
GROK_BOT_WEBHOOK_AUTH_VALUE="Bearer REPLACE_WITH_ROUTINE_KEY"
GROK_BOT_CALLBACK_MODE=loopback
GROK_BOT_CALLBACK_HOST=127.0.0.1
GROK_BOT_CALLBACK_PORT=8789
GROK_BOT_CALLBACK_URL=http://127.0.0.1:8789/grok/reply
