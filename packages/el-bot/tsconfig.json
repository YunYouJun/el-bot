{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@el-bot/commands": ["../commands/src/index.ts"],
      "el-bot/adapter": ["core/adapter.ts"],
      "#plugin-qq": ["../plugin-qq/src/index.ts"],
      "qq-sdk": ["../qq-sdk/src/index.ts"],
      "qq-sdk/official": ["../qq-sdk/src/official/index.ts"],
      "el-bot": [
        "index.ts"
      ],
      "#qq-sdk": [
        "../qq-sdk/src/index.ts"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  }
}
