{
  "name": "el-bot",
  "type": "module",
  "version": "1.0.0-rc.1",
  "description": "QQ bot framework and local Codex remote control CLI",
  "author": {
    "name": "云游君",
    "email": "me@yunyoujun.cn",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "AGPL-3.0",
  "homepage": "https://docs.bot.elpsy.cn/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/el-bot.git",
    "directory": "packages/el-bot"
  },
  "bugs": {
    "url": "https://github.com/YunYouJun/el-bot/issues"
  },
  "keywords": [
    "el-bot",
    "elpsy",
    "bot",
    "mirai",
    "qq",
    "framework"
  ],
  "imports": {
    "#qq-sdk": {
      "types": "./dist/qq-sdk.d.mts",
      "default": "./dist/qq-sdk.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./nest": {
      "types": "./dist/nest.d.mts",
      "import": "./dist/nest.mjs",
      "default": "./dist/nest.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "el": "./dist/cli.mjs",
    "el-bot": "./dist/cli.mjs"
  },
  "files": [
    "bin",
    "core",
    "dist",
    "index.ts",
    "node",
    "plugins",
    "types"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "mcl": {
    "folder": "mcl"
  },
  "scripts": {
    "build:api": "typedoc",
    "dev": "vite-node --watch bin/legacy.ts",
    "release": "pnpm -w release",
    "build": "tsdown",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@nestjs/common": "catalog:",
    "@octokit/webhooks": "catalog:",
    "@octokit/webhooks-methods": "catalog:",
    "@resvg/resvg-js": "catalog:",
    "@types/node-schedule": "catalog:",
    "@types/ws": "catalog:",
    "ajv": "catalog:",
    "axios": "catalog:",
    "c12": "catalog:",
    "chalk": "catalog:",
    "commander": "catalog:",
    "consola": "catalog:",
    "dayjs": "catalog:",
    "dotenv": "catalog:",
    "enquirer": "catalog:",
    "events": "catalog:",
    "fast-glob": "catalog:",
    "fs-extra": "catalog:",
    "gradient-string": "catalog:",
    "hono": "catalog:",
    "hookable": "catalog:",
    "html-to-text": "catalog:",
    "js-yaml": "catalog:",
    "mirai-ts": "catalog:",
    "mongoose": "catalog:",
    "node-napcat-ts": "catalog:",
    "node-schedule": "catalog:",
    "picocolors": "catalog:",
    "progress": "catalog:",
    "qq-guild-bot": "catalog:",
    "qrcode": "catalog:",
    "rss-parser": "catalog:",
    "shelljs": "catalog:",
    "tweetnacl": "catalog:",
    "vite-node": "catalog:",
    "winston": "catalog:",
    "ws": "catalog:",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@el-bot/qq-codex": "workspace:*",
    "@types/fs-extra": "catalog:",
    "@types/gradient-string": "catalog:",
    "@types/html-to-text": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "@types/progress": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/shelljs": "catalog:",
    "@types/xml2js": "catalog:",
    "@types/yargs": "catalog:",
    "cross-env": "catalog:",
    "qq-sdk": "workspace:*",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "directories": {
    "lib": "https://github.com/YunYouJun/mirai-ts"
  },
  "ecosystem": {
    "el-bot-api": "https://github.com/ElpsyCN/el-bot-api",
    "el-bot-plugins": "https://github.com/ElpsyCN/el-bot-plugins",
    "el-bot-docs": "https://github.com/ElpsyCN/el-bot-docs",
    "el-bot-template": "https://github.com/ElpsyCN/el-bot-template",
    "el-bot-web": "https://github.com/ElpsyCN/el-bot-web"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
