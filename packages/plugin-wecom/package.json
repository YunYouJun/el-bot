{
  "name": "@el-bot/plugin-wecom",
  "type": "module",
  "version": "0.0.1",
  "description": "WeCom smart-bot long connections and group webhook notifications with optional inbound forwarding",
  "license": "AGPL-3.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "el-bot-wecom": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "el-bot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "el-bot": { "optional": true }
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "catalog:",
    "consola": "catalog:",
    "dotenv": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
