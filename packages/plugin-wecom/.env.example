# Copy to the repo-root .env (gitignored) when you run `pnpm wecom`,
# or to packages/plugin-wecom/.env when you run `pnpm --filter @el-bot/plugin-wecom start`.
# Never commit real bot secrets or webhook keys.

# smart: smart bot over a long connection (default).
# webhook: group notification bot; requires only WECOM_GROUP_WEBHOOK_URL.
WECOM_BOT_TYPE=smart

# Smart-bot credentials. No callback URL or forwarding webhook is required.
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret

# Optional. Public WeCom uses the default. Private deployments set their gateway.
# WECOM_WS_URL=wss://openws.work.weixin.qq.com

# Group notification bot. Select WECOM_BOT_TYPE=webhook to use this URL.
# WECOM_GROUP_WEBHOOK_URL=https://example.invalid/wecom/send?key=REPLACE_WITH_GROUP_KEY

# Optional smart-bot forwarding to an external service such as a Grok routine.
# Set the URL and full auth value together to enable forwarding.
# WECOM_FORWARD_WEBHOOK_URL=https://example.invalid/grok/routines/wecom-inbound
# WECOM_FORWARD_WEBHOOK_AUTH_HEADER=Authorization
# WECOM_FORWARD_WEBHOOK_AUTH_VALUE=Bearer REPLACE_WITH_ROUTINE_KEY

# Optional JSON config path. Environment variables override file values.
# WECOM_CONFIG=wecom.config.json

# Optional heartbeat interval in milliseconds (minimum 1000, default 30000).
# WECOM_HEARTBEAT_MS=30000
