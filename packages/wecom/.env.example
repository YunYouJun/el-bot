# Copy to the repo-root .env (gitignored) when you run `pnpm wecom`,
# or to packages/wecom/.env when you run `pnpm --filter @el-bot/wecom start`.
# Never commit real Bot secrets or webhook keys.

# WeCom 智能机器人 long-connection credentials.
# 管理后台 → 智能机器人 → API 模式 → 长连接.
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret

# Optional. Public WeCom uses the default. Private deployments set their gateway.
# WECOM_WS_URL=wss://openws.work.weixin.qq.com

# Grok Bot routine「企微入站」. Paste the Webhook URL from the routine panel.
WECOM_WEBHOOK_URL=https://example.invalid/grok/routines/wecom-inbound

# Header name and full value from the routine panel.
# Typical panel value: Authorization: Bearer <key>
WECOM_WEBHOOK_AUTH_HEADER=Authorization
WECOM_WEBHOOK_AUTH_VALUE=Bearer REPLACE_WITH_ROUTINE_KEY

# Optional JSON config path. Environment variables override file values.
# WECOM_CONFIG=wecom.config.json

# Optional heartbeat interval in milliseconds (minimum 1000, default 30000).
# WECOM_HEARTBEAT_MS=30000
