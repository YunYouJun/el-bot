    "compatibility": { "dshReleases": { "0.2.2-rc.1": "compatible" } }
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": { "react": ">=18 <20" },
  "devDependencies": { "@types/node": "catalog:", "@types/react": "catalog:", "react": "catalog:", "tsdown": "catalog:", "typescript": "catalog:" }
