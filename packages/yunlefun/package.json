{
  "name": "@el-bot/yunlefun",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "YunLeFun account and AI point provider for DSH",
  "license": "AGPL-3.0",
  "exports": { ".": "./dist/index.mjs", "./client": "./dist/client.js" },
  "files": ["cordis.patch.yml", "deploy", "dist"],
