{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "el-bot": [
        "packages/el-bot/index.ts"
      ],
      "qq-sdk": [
        "packages/qq-sdk/src/index.ts"
      ],
      "@el-bot/codex": [
        "packages/codex/src/index.ts"
      ],
      "qq-sdk/official": [
        "packages/qq-sdk/src/official/index.ts"
      ],
      "#qq-sdk": [
        "packages/qq-sdk/src/index.ts"
      ]
    },
    "allowJs": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.spec.ts"
  ]
}
