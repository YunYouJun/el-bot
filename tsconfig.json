{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@el-bot/dsh": ["packages/dsh/src/index.ts"],
      "@el-bot/persona": ["packages/persona/src/index.ts"],
      "el-bot/adapter": ["packages/el-bot/core/adapter.ts"],
      "#plugin-qq": ["packages/plugin-qq/src/index.ts"],
      "@el-bot/plugin-qq": ["packages/plugin-qq/src/index.ts"],
      "@el-bot/plugin-wecom": ["packages/plugin-wecom/src/index.ts"],
      "@el-bot/plugin-grok": ["packages/plugin-grok/src/index.ts"],
      "el-bot": [
        "packages/el-bot/index.ts"
      ],
      "el-bot/nest": [
        "packages/el-bot/core/nest/index.ts"
      ],
      "qq-sdk": [
        "packages/qq-sdk/src/index.ts"
      ],
      "@el-bot/codex": [
        "packages/codex/src/index.ts"
      ],
      "qq-sdk/official": [
        "packages/qq-sdk/src/official/index.ts"
      ],
      "#qq-sdk": [
        "packages/qq-sdk/src/index.ts"
      ]
    },
    "allowJs": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "packages/dsh/src/client.ts",
    "packages/mobile/src/client.ts",
    "packages/mobile/src/client.test.ts",
    "packages/yunlefun/src/client.ts",
    "packages/dsh/web/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/*.spec.ts",
    "**/.nsh/**",
    "apps/el-bot-client/native/target/**"
  ]
}
